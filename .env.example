# Public: safe to embed in the browser. Set separately for every deployment.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: never prefix with NEXT_PUBLIC_. Used for OWNER staff invitations,
# initial-owner bootstrap, and rate-limited public booking/availability RPCs.
# Use the project's secret API key (or legacy service-role key).
SUPABASE_SECRET_KEY=

# Optional server-only transactional email delivery (Resend). Supabase Auth
# still sends confirmation, recovery and invitation emails through its SMTP setup.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shared production rate limiter (Upstash Redis REST). Required in production.
# Requests fail closed when either value is missing or the provider is unavailable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CLI only. Prefer interactive login/link; never expose these to the app/browser.
SUPABASE_PROJECT_ID=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=

# Server-only PayMongo TEST integration. Never add a NEXT_PUBLIC_ prefix.
# PayMongo test key (sk_test_...) is required to enable Pay online in development.
PAYMONGO_SECRET_KEY=
# Required as the explicit opt-in when enabling the test-only adapter in a Vercel production runtime.
# The adapter rejects sk_live_ keys in every environment.
PAYMONGO_TEST_MODE_ENABLED=
# Optional until the public HTTPS webhook has been registered in PayMongo TEST mode.
PAYMONGO_WEBHOOK_SECRET=

# Timezone, currency, policies and branding belong in database settings.
