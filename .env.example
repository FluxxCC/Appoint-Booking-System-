# Public: safe to embed in the browser. Set separately for every deployment.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: never prefix with NEXT_PUBLIC_. Used for OWNER staff invitations,
# initial-owner bootstrap, and rate-limited public booking/availability RPCs.
# Use the project's secret API key (or legacy service-role key).
SUPABASE_SECRET_KEY=

# Server-only application transactional email delivery (Resend API).
# Supabase Auth confirmation, recovery and invitation emails use its separate SMTP setup.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Server-only bearer secret used by the Vercel Cron notification dispatcher.
# Configure a high-entropy value in every deployment environment.
CRON_SECRET=

# Shared production rate limiter (Upstash Redis REST). Required in production.
# Requests fail closed when either value is missing or the provider is unavailable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CLI only. Prefer interactive login/link; never expose these to the app/browser.
SUPABASE_PROJECT_ID=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=

# Server-only PayMongo Hosted Checkout. Never add a NEXT_PUBLIC_ prefix.
# Set a test key for development/staging or a live key for the production payment environment.
PAYMONGO_SECRET_KEY=
# Production must explicitly opt into exactly one mode. Development accepts test keys only.
PAYMONGO_TEST_MODE_ENABLED=
# Use true only in the production environment configured for live charges; live keys are rejected elsewhere.
PAYMONGO_LIVE_MODE_ENABLED=
# Use the signing secret for the same mode as PAYMONGO_SECRET_KEY.
PAYMONGO_WEBHOOK_SECRET=

# Timezone, currency, policies and branding belong in database settings.
